{
  "index_patterns": ["financial-ml-predictions-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "30s"
    },
    "mappings": {
      "properties": {
        "@timestamp":      { "type": "date" },
        "category":        { "type": "keyword" },
        "symbol":          { "type": "keyword" },
        "prediction":      { "type": "keyword" },
        "confidence":      { "type": "double" },
        "rf_probability":  { "type": "double" },
        "gbt_probability": { "type": "double" },
        "lr_probability":  { "type": "double" },
        "model_votes":     { "type": "integer" },
        "current_price":   { "type": "double" }
      }
    }
  }
}
