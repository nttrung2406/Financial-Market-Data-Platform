{
  "index_patterns": ["financial-forex-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "10s"
    },
    "mappings": {
      "properties": {
        "@timestamp":     { "type": "date" },
        "base_currency":  { "type": "keyword" },
        "target_currency":{ "type": "keyword" },
        "pair":           { "type": "keyword" },
        "rate":           { "type": "double" }
      }
    }
  }
}
