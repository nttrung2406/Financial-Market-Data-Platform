{
  "index_patterns": ["financial-stocks-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s"
    },
    "mappings": {
      "properties": {
        "@timestamp":  { "type": "date" },
        "symbol":      { "type": "keyword" },
        "price":       { "type": "double" },
        "open_price":  { "type": "double" },
        "high_price":  { "type": "double" },
        "low_price":   { "type": "double" },
        "close_price": { "type": "double" },
        "volume":      { "type": "double" },
        "currency":    { "type": "keyword" },
        "ma5":         { "type": "double" },
        "ma20":        { "type": "double" },
        "ma50":        { "type": "double" },
        "rsi":         { "type": "double" }
      }
    }
  }
}
