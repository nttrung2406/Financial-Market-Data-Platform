{
  "index_patterns": ["financial-crypto-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s"
    },
    "mappings": {
      "properties": {
        "@timestamp":   { "type": "date" },
        "symbol":       { "type": "keyword" },
        "price":        { "type": "double" },
        "high_24h":     { "type": "double" },
        "low_24h":      { "type": "double" },
        "volume_24h":   { "type": "double" },
        "quote_volume": { "type": "double" },
        "ma5":          { "type": "double" },
        "ma20":         { "type": "double" },
        "ma50":         { "type": "double" },
        "rsi":          { "type": "double" }
      }
    }
  }
}
